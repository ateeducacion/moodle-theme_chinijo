# Local development settings for the Chinijo theme. Copy to .env and adjust.
# DEVELOPMENT ONLY: never reuse these values on a real site.

# Moodle release to run: 4.5, 5.0, 5.1, 5.2 or 5.3 (default 5.3). Each release keeps its own volumes.
MOODLE_VERSION=5.3

# Host port of the web server. SITE_URL is derived from it.
CHINIJO_HTTP_PORT=8080

# Administrator account of the local site (development only).
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Chinijo-dev-1234
MOODLE_ADMIN_EMAIL=admin@example.com

# PostgreSQL credentials of the local database (development only).
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=moodle-dev-only
