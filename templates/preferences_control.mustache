{{!
    @template theme_chinijo/preferences_control

    Control that opens the display settings. It is a link to the stand-alone
    page, so it works without JavaScript; theme_chinijo/preferences turns it
    into a button that opens the same form in a dialogue.

    Context variables required for this template:
    * url - URL of the stand-alone display settings page.
    * toolbar - True when rendered as a toolbar on layouts without Boost's navbar.
    * form - Rendered theme_chinijo/preferences_form used by the dialogue.

    Example context (json):
    {
        "url": "https://moodle.example/theme/chinijo/preferences.php",
        "toolbar": false,
        "form": "<form></form>"
    }
}}
{{#toolbar}}<div class="theme-chinijo-toolbar" data-region="theme_chinijo-toolbar">{{/toolbar}}
<div class="theme-chinijo-prefs-control" data-region="theme_chinijo-preferences-control">
    <a href="{{url}}" class="theme-chinijo-prefs-trigger" data-action="theme_chinijo-open-preferences">
        <span class="theme-chinijo-prefs-trigger__glyph" aria-hidden="true">Aa</span>
        <span class="theme-chinijo-prefs-trigger__label">{{#str}}displaysettings, theme_chinijo{{/str}}</span>
    </a>
    <template data-region="theme_chinijo-preferences-form">{{{form}}}</template>
</div>
{{#toolbar}}</div>{{/toolbar}}
