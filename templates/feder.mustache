{{!
    @template theme_chinijo/feder

    European Union emblem and FEDER acknowledgement configured by an administrator.

    Context variables required for this template:
    * landmark - True to render a complementary landmark (outside the main region).
    * logourl - URL of the approved emblem, or null.
    * logoalt - Text alternative of the emblem.
    * text - Formatted acknowledgement HTML, or an empty string.

    Example context (json):
    {
        "landmark": true,
        "logourl": "https://moodle.example/pluginfile.php/1/theme_chinijo/federlogo/0/emblem.png",
        "logoalt": "Co-funded by the European Union",
        "text": "<p>Acknowledgement text approved by the institution.</p>"
    }
}}
{{#landmark}}<aside class="theme-chinijo-feder" aria-label="{{#str}}feder_region, theme_chinijo{{/str}}" data-region="theme_chinijo-feder">{{/landmark}}
{{^landmark}}<div class="theme-chinijo-feder" data-region="theme_chinijo-feder">{{/landmark}}
    <div class="theme-chinijo-feder__inner">
        {{#logourl}}
            <img class="theme-chinijo-feder__emblem" src="{{logourl}}" alt="{{logoalt}}">
        {{/logourl}}
        {{#text}}
            <div class="theme-chinijo-feder__text">{{{text}}}</div>
        {{/text}}
    </div>
{{#landmark}}</aside>{{/landmark}}
{{^landmark}}</div>{{/landmark}}
