{{!
    @template theme_chinijo/learning_path_next

    The "Next" card of the course page: the next activity to do and a large
    link to start it, or a message when every activity is done. Rendered by
    theme_chinijo/learning_path, and again by theme_chinijo/completion_feedback
    when the learner marks an activity as done.

    Context variables required for this template:
    * alldone - True when every activity is done.
    * name - Name of the next activity.
    * url - URL of the next activity.
    * modname - Type of activity, for example "Assignment".
    * iconurl - URL of the activity icon, used when there is no pictogram.
    * pictogramurl - URL of the activity pictogram, or an empty string.

    Example context (json):
    {
        "alldone": false,
        "name": "Draw your family",
        "url": "https://moodle.example/mod/assign/view.php?id=3",
        "modname": "Assignment",
        "iconurl": "https://moodle.example/theme/image.php/chinijo/assign/1/monologo",
        "pictogramurl": ""
    }
}}
<div class="theme-chinijo-next{{#alldone}} theme-chinijo-next--done{{/alldone}}" data-region="theme_chinijo-next">
    <div class="theme-chinijo-next__picture" aria-hidden="true">
        {{#alldone}}
            <svg class="theme-chinijo-next__star" viewBox="0 0 48 48" width="64" height="64" focusable="false"><path d="M24 4l5.9 12.6 13.8 1.6-10.2 9.4 2.8 13.6L24 34.4 11.7 41.2l2.8-13.6L4.3 18.2l13.8-1.6z"></path></svg>
        {{/alldone}}
        {{^alldone}}
            {{#pictogramurl}}<img src="{{pictogramurl}}" alt="" class="theme-chinijo-next__pictogram">{{/pictogramurl}}
            {{^pictogramurl}}<img src="{{iconurl}}" alt="" class="theme-chinijo-next__icon">{{/pictogramurl}}
        {{/alldone}}
    </div>
    <div class="theme-chinijo-next__text">
        <h2 class="theme-chinijo-next__eyebrow">{{#str}}path_next, theme_chinijo{{/str}}</h2>
        {{#alldone}}
            <p class="theme-chinijo-next__name">{{#str}}path_alldone, theme_chinijo{{/str}}</p>
        {{/alldone}}
        {{^alldone}}
            <p class="theme-chinijo-next__name">{{name}}</p>
            <p class="theme-chinijo-next__type">{{modname}}</p>
        {{/alldone}}
    </div>
    {{^alldone}}
        <a class="btn btn-primary theme-chinijo-next__start" href="{{url}}">
            <svg class="theme-chinijo-icon theme-chinijo-icon--solid" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z"></path></svg>
            {{#str}}path_start, theme_chinijo{{/str}}<span class="theme-chinijo-visually-hidden">: {{name}}</span>
        </a>
    {{/alldone}}
</div>
