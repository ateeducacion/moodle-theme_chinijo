{{!
    @template theme_chinijo/course_progress

    Course progress of the current user, from Moodle's completion data only.

    Context variables required for this template:
    * courseid - Course id.
    * completed - Number of completed activities.
    * total - Number of activities with completion that are counted.
    * percentage - Whole percentage, rounded down.
    * coursecomplete - Whether Moodle marks the whole course as completed.
    * cmidsjson - JSON list of the counted course module ids.

    Example context (json):
    {
        "courseid": 2,
        "completed": 3,
        "total": 8,
        "percentage": 37,
        "coursecomplete": false,
        "cmidsjson": "[10,11,12,13,14,15,16,17]"
    }
}}
<div class="theme-chinijo-progress" data-region="theme_chinijo-progress" data-courseid="{{courseid}}" data-cmids="{{cmidsjson}}" data-completed="{{completed}}" data-total="{{total}}">
    <p class="theme-chinijo-progress__label" id="theme-chinijo-progress-label-{{courseid}}" data-region="theme_chinijo-progress-label">
        {{#coursecomplete}}
            <span class="theme-chinijo-progress__done">{{#str}}progress_coursecomplete, theme_chinijo{{/str}}</span>
        {{/coursecomplete}}
        {{^coursecomplete}}
            {{#str}}progress_summary, theme_chinijo, { "completed": {{completed}}, "total": {{total}}, "percentage": {{percentage}} }{{/str}}
        {{/coursecomplete}}
    </p>
    {{#total}}
        <progress class="theme-chinijo-progress__bar" max="{{total}}" value="{{#coursecomplete}}{{total}}{{/coursecomplete}}{{^coursecomplete}}{{completed}}{{/coursecomplete}}" aria-labelledby="theme-chinijo-progress-label-{{courseid}}" data-region="theme_chinijo-progress-bar">{{percentage}}%</progress>
    {{/total}}
</div>
